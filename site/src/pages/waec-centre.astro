---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Counter from '../components/react/Counter';
import { school, whatsappLink, fullAddress } from '../data/school';
import { photos } from '../data/photos';

const hasWaec = school.waec.candidates != null && school.waec.fiveCreditsPct != null;
const why = [
  { t: 'Approved centre', d: 'Topheight College is approved by WAEC to host the West African Senior School Certificate Examination.' },
  { t: 'Calm, secure venue', d: 'A walled, gated compound with supervised entry, so candidates can focus on their papers.' },
  { t: 'Laboratory for practicals', d: 'A dedicated science block for practical papers.' },
  { t: 'Easy to reach', d: 'Off Ibusa Expressway in Akwofor, Asaba, convenient for schools and private candidates across the area.' },
];
---
<Base title="WAEC Examination Centre" description="Topheight College, Asaba is an approved WAEC examination centre. Information for schools and candidates wishing to register and write WASSCE with us." ogImage={photos.labBuilding.img}>
  <PageHero title="WAEC Centre" crumb="WAEC Centre" photo={photos.labBuilding} position="center 30%"
    intro="Topheight College is an approved WAEC examination centre. Our own students write here, and schools that need a centre for their candidates are welcome to register with us.">
    <a href={whatsappLink('Hello Topheight, I would like information on registering candidates for WAEC at your centre.')} target="_blank" rel="noopener"
       class="reveal mt-8 inline-flex rounded-full bg-gold-500 px-7 py-4 font-semibold text-navy-950 hover:bg-gold-400" style="--d:300ms">Ask about registration</a>
  </PageHero>

  {hasWaec && (
    <section class="bg-gold-500">
      <dl class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 py-14 sm:grid-cols-2">
        <div><dt class="font-semibold text-navy-950/70">Our candidates ({school.waec.year})</dt><dd class="display text-6xl text-navy-950"><Counter client:visible to={school.waec.candidates} /></dd></div>
        <div><dt class="font-semibold text-navy-950/70">5 credits incl. English & Maths</dt><dd class="display text-6xl text-navy-950"><Counter client:visible to={school.waec.fiveCreditsPct} suffix="%" /></dd></div>
      </dl>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24">
    <SectionHead title="Why write at Topheight" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {why.map((w, i) => (
        <div class="reveal rounded-3xl border-t-[6px] border-gold-500 bg-white p-8 ring-1 ring-navy-900/5" style={`--d:${i * 80}ms`}>
          <h3 class="text-xl font-bold text-navy-900">{w.t}</h3>
          <p class="mt-2 leading-relaxed text-ink/70">{w.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-navy-900 py-24 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 grid gap-14 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHead title="For schools & candidates" light intro="Registration windows and fees are set by WAEC each year. Contact us early so we can guide you through the process and confirm space at the centre." />
        <dl class="reveal mt-8 space-y-4 text-white/80">
          <div><dt class="text-sm font-bold text-white">Centre address</dt><dd>{fullAddress}</dd></div>
          <div><dt class="text-sm font-bold text-white">Phone</dt><dd>{school.phonesDisplay.join(' · ')}</dd></div>
        </dl>
      </div>
      <div class="reveal overflow-hidden rounded-3xl"><Image src={photos.labGold.img} alt={photos.labGold.alt} widths={[480, 720]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
    </div>
  </section>
</Base>
