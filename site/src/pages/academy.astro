---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { academyStages } from '../data/school';
import { photos } from '../data/photos';

const focus = [
  { t: 'Reading & phonics', d: 'Early reading built step by step, so children read with confidence by the end of the early years.' },
  { t: 'Numeracy', d: 'Numbers, shapes and problem-solving taught through play, practice and real-life examples.' },
  { t: 'Science & discovery', d: 'Curious questions encouraged from the start, preparing pupils for the laboratory in College.' },
  { t: 'Creative arts', d: 'Drawing, music, drama and craft that let children express themselves.' },
  { t: 'Character', d: 'Humility, Empathy and Prospect taught through daily routines, assemblies and example.' },
  { t: 'Special days', d: 'Career Day, celebrations and house events that make school memorable.' },
];
---
<Base title="Topheight Academy (Nursery & Primary)" description="Topheight Academy, Asaba: nursery and primary education that builds reading, numeracy and character." ogImage={photos.doctors.img}>
  <PageHero title="Topheight Academy" crumb="Academy" accent="sky" photo={photos.doctors} position="center 35%"
    intro="Nursery and primary education in a bright, caring setting, where children learn to read, count, question and get along." />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24">
    <SectionHead title="Stages" />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {academyStages.map((s, i) => (
        <div class="reveal rounded-3xl border-t-[6px] border-sky-500 bg-white p-8 sm:p-10 shadow-sm ring-1 ring-navy-900/5" style={`--d:${i * 100}ms`}>
          <p class="text-sm font-bold text-sky-600">{s.classes}</p>
          <h3 class="display mt-2 text-4xl uppercase text-navy-900">{s.name}</h3>
          <p class="mt-4 text-lg leading-relaxed text-ink/70">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sky-500 py-24 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead title="What we focus on" light />
      <div class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-white/20 sm:grid-cols-2 lg:grid-cols-3">
        {focus.map((f, i) => (
          <div class="reveal bg-sky-500 p-8" style={`--d:${(i % 3) * 80}ms`}>
            <h3 class="text-xl font-bold">{f.t}</h3>
            <p class="mt-2 leading-relaxed text-white/85">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24 grid gap-6 md:grid-cols-2">
    <div class="reveal overflow-hidden rounded-3xl"><Image src={photos.eventDay.img} alt={photos.eventDay.alt} widths={[480, 800]} sizes="(min-width:768px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
    <div class="reveal overflow-hidden rounded-3xl" style="--d:120ms"><Image src={photos.lawyers.img} alt={photos.lawyers.alt} widths={[480, 600]} sizes="(min-width:768px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover object-top" /></div>
  </section>

  <CtaBand title="Give your child a strong start" text="Admissions are open for Nursery and Primary. Message us to book a visit." />
</Base>
