---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-32 text-center">
    <p class="display text-8xl text-navy-900">404</p>
    <div class="stripe mx-auto mt-6 h-2 w-32 rounded-full"></div>
    <h1 class="mt-8 text-2xl font-bold text-navy-900">We couldn't find that page.</h1>
    <p class="mt-3 text-ink/70">It may have moved. Try the home page or get in touch.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-navy-900 px-7 py-4 font-semibold text-white">Go home</a>
      <a href="/contact" class="rounded-full border-2 border-navy-900 px-7 py-4 font-semibold text-navy-900">Contact us</a>
    </div>
  </section>
</Base>
