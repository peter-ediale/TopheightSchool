---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Testimonials from '../components/Testimonials.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import Counter from '../components/react/Counter';
import { school, houses, leadership } from '../data/school';
import { photos } from '../data/photos';
import logo from '../assets/brand/logo.png';

const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-NG', { day: 'numeric', month: 'long', year: 'numeric' });
const hasWaec = school.waec.candidates != null && school.waec.fiveCreditsPct != null;
const head = leadership[0];

const facts = [
  { k: `${school.waec.fiveCreditsPct}%`, v: `English & Maths credits, WASSCE ${school.waec.year}` },
  { k: 'Nursery → SS 3', v: 'One school for every stage' },
  { k: 'Science lab', v: 'Practicals, not just theory' },
  { k: 'WAEC centre', v: 'Approved examination venue' },
];
---
<Base>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-navy-950">
    <Image src={photos.building.img} alt={photos.building.alt} widths={[720, 1280]} sizes="100vw" loading="eager" fetchpriority="high"
           class="slowzoom absolute inset-0 -z-10 h-full w-full object-cover object-[60%_center]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/80 to-navy-950/20" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950/80 to-transparent sm:hidden" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 sm:py-28 lg:py-36">
      <p class="reveal mb-8 text-sm font-semibold text-gold-400">Topheight Academy · Topheight College · Asaba</p>
      <HeroHeadline />
      <p class="reveal mt-8 max-w-xl text-lg leading-relaxed text-white/85" style="--d:700ms">
        From first words in nursery to final papers in SS 3, Topheight raises children who learn well, think for themselves and treat people right.
      </p>
      <div class="reveal mt-10 flex flex-wrap gap-3" style="--d:850ms">
        <a href="/admissions" class="rounded-full bg-gold-500 px-7 py-4 font-semibold text-navy-950 transition hover:-translate-y-0.5 hover:bg-gold-400">Admissions</a>
        <a href="/about" class="rounded-full border border-white/40 px-7 py-4 font-semibold text-white transition hover:bg-white hover:text-navy-950">Our story</a>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="bg-white border-b border-navy-900/10">
    <dl class="mx-auto grid max-w-7xl grid-cols-2 lg:grid-cols-4 px-4 sm:px-6">
      {facts.map((f, i) => (
        <div class="reveal border-navy-900/10 py-8 sm:py-10 px-2 sm:px-6 [&:nth-child(odd)]:border-r lg:border-r lg:last:border-r-0 [&:nth-child(-n+2)]:border-b lg:[&:nth-child(-n+2)]:border-b-0" style={`--d:${i * 80}ms`}>
          <dt class="display text-xl sm:text-3xl uppercase text-navy-900">{f.k}</dt>
          <dd class="mt-2 text-sm text-ink/65">{f.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- WELCOME -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24 sm:py-32 grid gap-14 lg:grid-cols-2 lg:items-center">
    <div class="reveal relative">
      <Image src={photos.welcome.img} alt={photos.welcome.alt} widths={[480, 720]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/5] w-full rounded-3xl object-cover" />
      <div class="absolute -bottom-6 -right-3 sm:-right-6 grid size-32 sm:size-36 place-items-center rounded-full bg-white shadow-2xl ring-8 ring-paper">
        <Image src={logo} alt="Topheight crest" widths={[160, 240]} sizes="120px" class="h-24 sm:h-28 w-auto" />
      </div>
    </div>
    <div>
      <SectionHead title="Welcome to Topheight" />
      <div class="reveal mt-6 space-y-5 text-lg leading-relaxed text-ink/75">
        {head?.message ? <p>{head.message}</p> : (
          <>
            <p>Every child who walks through our gate is on a climb. Some are taking their very first steps in nursery; others are a few papers away from WAEC. Our job is the same for both: know them by name, stretch them, and keep them steady.</p>
            <p><strong class="text-navy-900">Topheight Academy</strong> lays the foundation in nursery and primary. <strong class="text-navy-900">Topheight College</strong> builds on it through JSS and SSS, all the way to WAEC, written right here in our own approved centre. In {school.waec.year}, every one of our {school.waec.candidates} candidates earned a credit in both English and Mathematics.</p>
          </>
        )}
      </div>
      {head && <p class="reveal mt-6 font-semibold text-navy-900">{head.name}<span class="block text-sm font-normal text-ink/60">{head.role}</span></p>}
      <a href="/about" class="reveal mt-8 inline-flex items-center gap-2 font-semibold text-sky-600 hover:gap-3 transition-all">Read our story <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- OUR SCHOOLS -->
  <section class="bg-sky-50 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead title="Two schools, one family" intro="Children can join us in nursery and stay with us all the way to SS 3." />
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        <a href="/academy" class="reveal group block overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-navy-900/5 transition hover:-translate-y-1 hover:shadow-2xl">
          <div class="relative overflow-hidden">
            <Image src={photos.eventDay.img} alt={photos.eventDay.alt} widths={[480, 800]} sizes="(min-width:768px) 45vw, 100vw" class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-105" />
            <span class="absolute left-5 top-5 rounded-full bg-white px-3 py-1 text-xs font-bold text-sky-600">Nursery & Primary</span>
          </div>
          <div class="border-t-[6px] border-sky-500 p-8">
            <h3 class="display text-3xl uppercase text-navy-900">Topheight Academy</h3>
            <p class="mt-3 text-ink/70 leading-relaxed">Early years and primary education that builds reading, numeracy and confidence, in a bright and caring setting.</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-sky-600">Explore the Academy <span class="transition group-hover:translate-x-1">→</span></span>
          </div>
        </a>
        <a href="/college" class="reveal group block overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-navy-900/5 transition hover:-translate-y-1 hover:shadow-2xl" style="--d:120ms">
          <div class="relative overflow-hidden">
            <Image src={photos.labGroup.img} alt={photos.labGroup.alt} widths={[480, 800]} sizes="(min-width:768px) 45vw, 100vw" class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-105" />
            <span class="absolute left-5 top-5 rounded-full bg-gold-500 px-3 py-1 text-xs font-bold text-navy-950">JSS 1 – SS 3</span>
          </div>
          <div class="border-t-[6px] border-gold-500 p-8">
            <h3 class="display text-3xl uppercase text-navy-900">Topheight College</h3>
            <p class="mt-3 text-ink/70 leading-relaxed">Secondary education with hands-on science and steady preparation for WAEC, written in our own approved centre.</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-navy-900">Explore the College <span class="transition group-hover:translate-x-1">→</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SCIENCE -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24 sm:py-32 grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:items-center">
    <div>
      <SectionHead title="Science you can touch" intro="Our laboratory is where students run titrations, look down microscopes and see for themselves what the textbook describes. When the WAEC practical comes, it is familiar ground." />
      <a href="/college#laboratory" class="reveal mt-8 inline-flex items-center gap-2 font-semibold text-sky-600 hover:gap-3 transition-all">Inside the laboratory <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid grid-cols-5 gap-4">
      <div class="reveal col-span-3 overflow-hidden rounded-3xl">
        <Image src={photos.labGold.img} alt={photos.labGold.alt} widths={[400, 720]} sizes="(min-width:1024px) 30vw, 60vw" class="aspect-[3/4] h-full w-full object-cover" />
      </div>
      <div class="reveal col-span-2 mt-16 overflow-hidden rounded-3xl" style="--d:150ms">
        <Image src={photos.labDemo.img} alt={photos.labDemo.alt} widths={[300, 600]} sizes="(min-width:1024px) 20vw, 40vw" class="aspect-[3/4] h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- WAEC -->
  <section class="bg-navy-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-24 sm:py-32 grid gap-14 lg:grid-cols-2 lg:items-center">
      <div class="reveal order-2 lg:order-1 overflow-hidden rounded-3xl">
        <Image src={photos.labBuilding.img} alt={photos.labBuilding.alt} widths={[480, 720]} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" />
      </div>
      <div class="order-1 lg:order-2">
        <p class="reveal mb-5 inline-block rounded-full bg-gold-500 px-4 py-1.5 text-sm font-bold text-navy-950">Approved WAEC centre</p>
        <SectionHead title="We prepare for WAEC, and we host it" light intro="Our SS 3 students write their exams in classrooms they know. Schools that need a centre for their own candidates are welcome to register with us." />
        {hasWaec && (
          <div class="reveal mt-10">
            <p class="text-sm font-bold uppercase tracking-wider text-white/60">WASSCE {school.waec.year} results</p>
            <dl class="mt-4 grid grid-cols-3 gap-px overflow-hidden rounded-2xl bg-white/15">
              <div class="flex flex-col-reverse bg-navy-900 p-4 sm:p-5"><dt class="mt-1 text-xs sm:text-sm text-white/70">candidates</dt><dd class="display text-3xl sm:text-5xl text-gold-400"><Counter client:visible to={school.waec.candidates} /></dd></div>
              <div class="flex flex-col-reverse bg-navy-900 p-4 sm:p-5"><dt class="mt-1 text-xs sm:text-sm text-white/70">credited in English &amp; Maths</dt><dd class="display text-3xl sm:text-5xl text-gold-400"><Counter client:visible to={school.waec.fiveCreditsPct} suffix="%" /></dd></div>
              {school.waec.a1Count != null && <div class="flex flex-col-reverse bg-navy-900 p-4 sm:p-5"><dt class="mt-1 text-xs sm:text-sm text-white/70">A1 distinctions</dt><dd class="display text-3xl sm:text-5xl text-gold-400"><Counter client:visible to={school.waec.a1Count} suffix="+" /></dd></div>}
            </dl>
          </div>
        )}
        <a href="/waec-centre" class="reveal mt-10 inline-flex rounded-full bg-gold-500 px-7 py-4 font-semibold text-navy-950 transition hover:-translate-y-0.5 hover:bg-gold-400">WAEC centre information</a>
      </div>
    </div>
  </section>

  <!-- HOUSES & LIFE -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-end">
      <SectionHead title="Five houses, one school" intro="Purple, green, yellow, red and blue. Every pupil belongs to a house, and the house colours come out for assemblies, sports and friendly competition all year." />
      <ul class="reveal flex flex-wrap gap-2 lg:justify-end" aria-label="School houses">
        {houses.map((h) => <li class="flex items-center gap-2 rounded-full border border-navy-900/10 bg-white py-2 pl-2 pr-4 text-sm font-semibold"><span class:list={['size-5 rounded-full', h.cls]}></span>{h.colour}</li>)}
      </ul>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <div class="reveal md:col-span-2 overflow-hidden rounded-3xl">
        <Image src={photos.assembly.img} alt={photos.assembly.alt} widths={[600, 1000]} sizes="(min-width:768px) 60vw, 100vw" class="aspect-[16/11] w-full object-cover object-[center_60%]" />
      </div>
      <a href="/gallery" class="reveal group relative block overflow-hidden rounded-3xl" style="--d:120ms">
        <Image src={photos.lawyers.img} alt={photos.lawyers.alt} widths={[400, 600]} sizes="(min-width:768px) 30vw, 100vw" class="aspect-[16/11] md:aspect-auto md:h-full w-full object-cover transition duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-transparent to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 text-white">
          <p class="display text-2xl uppercase">Career Day</p>
          <p class="mt-1 text-sm text-white/80">Future lawyers, doctors and engineers. See the gallery →</p>
        </div>
      </a>
    </div>
  </section>

  <Testimonials />

  <!-- NEWS -->
  <section class="bg-white py-24 border-t border-navy-900/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHead title="Latest news" />
        <a href="/news" class="reveal font-semibold text-sky-600">All news →</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {news.map((n, i) => (
          <a href={`/news/${n.id}`} class="reveal group block" style={`--d:${i * 100}ms`}>
            <div class="overflow-hidden rounded-2xl">
              <Image src={n.data.cover} alt={n.data.title} widths={[400, 640]} sizes="(min-width:768px) 30vw, 100vw" class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-105" />
            </div>
            <p class="mt-4 text-sm text-ink/60"><span class="font-semibold text-sky-600">{n.data.tag}</span> · {fmt(n.data.date)}</p>
            <h3 class="mt-2 text-xl font-bold text-navy-900 group-hover:underline">{n.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
