---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { school, whatsappLink, mapLink } from '../data/school';
import { photos } from '../data/photos';
import logo from '../assets/brand/logo.png';

interface Props { title?: string; description?: string; ogImage?: ImageMetadata }
const {
  title,
  description = 'Nursery, primary and secondary school in Asaba, Delta State. Science laboratory, approved WAEC centre, and 100% English & Maths credits in WASSCE 2026.',
  ogImage = photos.building.img,
} = Astro.props;
const logoImg = await getImage({ src: logo, width: 512, format: 'png' });
const fullTitle = title ? `${title} | Topheight Schools, Asaba` : 'Topheight Schools, Asaba | Nursery, Primary & Secondary School';
const og = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
const site = Astro.site ?? Astro.url;
const ogUrl = new URL(og.src, site).href;
const canonical = new URL(Astro.url.pathname, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: school.brand,
  alternateName: [school.academy.name, school.college.name],
  url: new URL('/', site).href,
  foundingDate: String(school.founded),
  slogan: school.motto.join(', '),
  telephone: school.phones,
  ...(school.email ? { email: school.email } : {}),
  image: ogUrl,
  logo: new URL(logoImg.src, site).href,
  hasMap: mapLink,
  areaServed: { '@type': 'City', name: 'Asaba' },
  ...(school.social.facebook || school.social.instagram
    ? { sameAs: [school.social.facebook, school.social.instagram].filter(Boolean) } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: school.address.street,
    addressLocality: `${school.address.area}, ${school.address.city}`,
    addressRegion: school.address.state,
    postalCode: school.address.postcode,
    addressCountry: school.address.country,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '07:45', closes: '15:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '07:45', closes: '13:00' },
  ],
};
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {school.googleVerification && <meta name="google-site-verification" content={school.googleVerification} />}
    <meta name="theme-color" content="#0b1f4d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Topheight Schools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:rounded focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <a href={whatsappLink()} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"
       class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-xl shadow-black/20 transition hover:scale-110">
      <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal, .stripe-draw');
      const show = (el: Element) => el.classList.add('is-in');
      if (!('IntersectionObserver' in window)) {
        els.forEach(show);
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => {
          // Anything already on screen at load is revealed straight away (doesn't depend on the observer firing)
          if (el.getBoundingClientRect().top < window.innerHeight) show(el);
          else io.observe(el);
        });
      }
    </script>
  </body>
</html>
