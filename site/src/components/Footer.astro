---
import Logo from './Logo.astro';
import { school, whatsappLink, mapLink, fullAddress, nav } from '../data/school';
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 text-white/70">
  <div class="stripe h-1.5 w-full"></div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo light />
      <p class="mt-6 leading-relaxed">{school.academy.name} (Nursery & Primary) and {school.college.name} (Secondary). Serving families in Asaba since {school.founded}.</p>
      <p class="display mt-6 text-lg uppercase text-white">{school.motto.join(' · ')}</p>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Explore</h3>
      <ul class="mt-4 grid gap-2">
        {nav.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Visit</h3>
      <address class="mt-4 not-italic leading-relaxed">{fullAddress}</address>
      <a href={mapLink} target="_blank" rel="noopener" class="mt-3 inline-block font-semibold text-gold-400 hover:text-gold-500">Get directions →</a>
    </div>
    <div>
      <h3 class="text-sm font-bold text-white">Contact</h3>
      <ul class="mt-4 grid gap-2">
        {school.phones.map((p, i) => <li><a href={`tel:${p}`} class="hover:text-white">{school.phonesDisplay[i]}</a></li>)}
        <li><a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-white">WhatsApp</a></li>
        {school.email && <li><a href={`mailto:${school.email}`} class="hover:text-white">{school.email}</a></li>}
        {school.social.facebook && <li><a href={school.social.facebook} target="_blank" rel="noopener" class="hover:text-white">Facebook</a></li>}
        {school.social.instagram && <li><a href={school.social.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a></li>}
      </ul>
      <ul class="mt-6 grid gap-1 text-sm">
        {school.hours.slice(0, 2).map((h) => <li><span class="text-white/90">{h.days}:</span> {h.time}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 text-sm flex flex-col sm:flex-row gap-2 justify-between">
      <p>© {year} {school.brand} · RC {school.rcNumber}</p>
      <p>Approved WAEC examination centre</p>
    </div>
  </div>
</footer>
