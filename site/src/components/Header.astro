---
import Logo from './Logo.astro';
import { whatsappLink } from '../data/school';

const links = [
  { href: '#schools', label: 'Our Schools' },
  { href: '#science', label: 'Science' },
  { href: '#waec', label: 'WAEC Centre' },
  { href: '#life', label: 'Student Life' },
  { href: '#visit', label: 'Visit Us' },
];
---
<header id="site-header" data-top="true" class="fixed inset-x-0 top-0 z-50 transition-all duration-500 data-[top=false]:bg-white/90 data-[top=false]:backdrop-blur-md data-[top=false]:shadow-[0_1px_0_rgba(11,31,77,.08)]">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6">
    <div class="header-logo-light"><Logo light /></div>
    <div class="header-logo-dark hidden"><Logo /></div>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="nav-link relative text-sm font-medium text-white/85 hover:text-white transition-colors after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:bg-gold-500 after:transition-all hover:after:w-full">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={whatsappLink()} target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-2 rounded-full bg-gold-500 px-5 py-2.5 text-sm font-semibold text-navy-950 shadow-lg shadow-gold-500/20 transition hover:bg-gold-400 hover:-translate-y-0.5">
        Enquire now
      </a>
      <button id="menu-btn" class="lg:hidden grid size-11 place-items-center rounded-full bg-white/10 text-white backdrop-blur transition" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Kept outside <header>: the header's backdrop-blur would otherwise trap this fixed overlay inside it -->
<div id="mobile-menu" class="lg:hidden fixed inset-0 z-[60] bg-navy-950 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto">
    <div class="flex h-20 items-center justify-between px-4 sm:px-6">
      <Logo light />
      <button id="menu-close" class="grid size-11 place-items-center rounded-full bg-white/10 text-white" aria-label="Close menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="flex flex-col gap-2 px-6 pt-8" aria-label="Mobile">
      {links.map((l, i) => (
        <a href={l.href} class="mobile-link font-display text-4xl text-white py-2 border-b border-white/10" style={`--d:${i * 60}ms`}>{l.label}</a>
      ))}
      <a href={whatsappLink()} target="_blank" rel="noopener" class="mt-8 inline-flex justify-center rounded-full bg-gold-500 px-6 py-4 font-semibold text-navy-950">Enquire on WhatsApp</a>
    </nav>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const light = header.querySelector('.header-logo-light')!;
  const dark = header.querySelector('.header-logo-dark')!;
  const navLinks = header.querySelectorAll<HTMLElement>('.nav-link');
  const btn = document.getElementById('menu-btn')!;
  const onScroll = () => {
    const top = window.scrollY < 40;
    header.dataset.top = String(top);
    light.classList.toggle('hidden', !top);
    dark.classList.toggle('hidden', top);
    navLinks.forEach((a) => {
      a.classList.toggle('text-white/85', top);
      a.classList.toggle('hover:text-white', top);
      a.classList.toggle('text-navy-900', !top);
    });
    btn.classList.toggle('bg-white/10', top);
    btn.classList.toggle('text-white', top);
    btn.classList.toggle('bg-navy-900', !top);
    btn.classList.toggle('text-white', true);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(true));
  document.getElementById('menu-close')!.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
