---
import Logo from './Logo.astro';
import { nav, whatsappLink, school } from '../data/school';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const desktop = nav.filter((l) => l.href !== '/news');
---
<div class="hidden md:block bg-navy-950 text-white/75 text-xs">
  <div class="mx-auto flex h-9 max-w-7xl items-center justify-between px-4 sm:px-6">
    <p>{school.address.area}, {school.address.city} · Since {school.founded}</p>
    <div class="flex items-center gap-5">
      <a href={`tel:${school.phones[0]}`} class="hover:text-white">{school.phonesDisplay[0]}</a>
      <a href={`tel:${school.phones[1]}`} class="hover:text-white">{school.phonesDisplay[1]}</a>
      <a href="/news" class="hover:text-white">News</a>
    </div>
  </div>
</div>

<header id="site-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-navy-900/10">
  <div class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-6 px-4 sm:px-6">
    <Logo />
    <nav class="hidden xl:flex items-center gap-1" aria-label="Main">
      {desktop.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}
           class="relative rounded-full px-3.5 py-2 text-[0.92rem] font-semibold text-navy-900/80 transition hover:bg-sky-50 hover:text-navy-900 aria-[current=page]:text-navy-900 aria-[current=page]:bg-sky-100">{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="/admissions#enquire" class="hidden sm:inline-flex rounded-full bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-700">Apply now</a>
      <button id="menu-btn" class="xl:hidden grid size-11 place-items-center rounded-full bg-navy-900 text-white" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Outside <header>: its backdrop-blur would otherwise trap this fixed overlay inside it -->
<div id="mobile-menu" class="xl:hidden fixed inset-0 z-[60] flex flex-col bg-navy-950 opacity-0 pointer-events-none transition-opacity duration-300 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto">
  <div class="stripe h-1.5 w-full"></div>
  <div class="flex h-[4.5rem] items-center justify-between px-4 sm:px-6">
    <Logo light />
    <button id="menu-close" class="grid size-11 place-items-center rounded-full bg-white/10 text-white" aria-label="Close menu">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto px-6 pt-4 pb-8" aria-label="Mobile">
    <a href="/" class="display block border-b border-white/10 py-3 text-3xl uppercase text-white">Home</a>
    {nav.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} class="display block border-b border-white/10 py-3 text-3xl uppercase text-white aria-[current=page]:text-gold-400">{l.label}</a>
    ))}
    <div class="mt-8 grid gap-3">
      <a href={whatsappLink()} target="_blank" rel="noopener" class="rounded-full bg-gold-500 px-6 py-4 text-center font-semibold text-navy-950">Enquire on WhatsApp</a>
      <a href={`tel:${school.phones[0]}`} class="rounded-full border border-white/25 px-6 py-4 text-center font-semibold text-white">Call {school.phonesDisplay[0]}</a>
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(true));
  document.getElementById('menu-close')!.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
