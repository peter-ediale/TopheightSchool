---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

interface Props { light?: boolean; size?: 'sm' | 'lg' }
const { light = false, size = 'sm' } = Astro.props;
---
<a href="/" class="flex items-center gap-3 group" aria-label="Topheight Schools home">
  <Image src={logo} alt="Topheight crest" widths={[96, 160]} sizes={size === 'lg' ? '80px' : '52px'} loading="eager"
         class:list={['w-auto shrink-0 transition-transform duration-500 group-hover:-rotate-3', size === 'lg' ? 'h-20' : 'h-[3.25rem]']} />
  <span class="leading-none">
    <span class:list={['display block text-[1.3rem] uppercase', light ? 'text-white' : 'text-navy-900']}>Topheight</span>
    <span class="mt-1.5 flex items-center gap-2">
      <span class="stripe block h-1 w-8 rounded-full"></span>
      <span class:list={['text-[10px] font-semibold uppercase tracking-[0.25em]', light ? 'text-white/80' : 'text-navy-700']}>Schools</span>
    </span>
  </span>
</a>
