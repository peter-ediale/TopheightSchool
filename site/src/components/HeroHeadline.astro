---
// The motto as the homepage headline. Each word rises in and is underlined in a house colour.
// Pure CSS (no JavaScript needed), so the headline is always visible to visitors and to Google.
const words = [
  { w: 'Humility.', bar: 'bg-house-purple' },
  { w: 'Empathy.', bar: 'bg-house-green' },
  { w: 'Prospect.', bar: 'bg-house-yellow' },
];
---
<h1 class="display text-[3.1rem] sm:text-7xl lg:text-8xl uppercase text-white">
  {words.map((x, i) => (
    <span class="block">
      <span class="relative inline-block overflow-hidden pb-2">
        <span class="hh-word inline-block" style={`animation-delay:${150 + i * 150}ms`}>{x.w}</span>
        <span class:list={['hh-bar absolute bottom-0 left-0 h-1.5 w-full origin-left rounded-full', x.bar]} style={`animation-delay:${600 + i * 150}ms`}></span>
      </span>
    </span>
  ))}
</h1>

<style>
  @keyframes hh-rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes hh-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hh-word { animation: hh-rise .8s cubic-bezier(.2,.7,.2,1) both; }
  .hh-bar { animation: hh-draw .8s cubic-bezier(.2,.7,.2,1) both; }
  @media (prefers-reduced-motion: reduce) { .hh-word, .hh-bar { animation: none; } }
</style>
